# Configuration template for local development
# Duplicate this file, rename it to '.env', and fill in your actual credentials

# Server port (defaults to 8000 if left blank)
PORT=8000

# Geoapify API Key (obtained from ://geoapify.com)
GEOAPIFY_API_KEY="your_geoapify_api_key_here"

# Live URL for the GTFS-Realtime transit feed
GTFS_RT_URL="your_gtfs_realtime_feed_url_here"

# Transit agency name
GTFS_AGENCY_NAME="your_transit_agency_name_here"

# Transit agency ID
GTFS_AGENCY_ID=your_transit_agency_id_here
